{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://github.com/MinBZK/par-dpia-form/blob/main/schemas/begrippenkader.v1.schema.json",
    "title": "Begrippenkader",
    "description": "Lijst met begripsdefinities die de invulhulp in de vraagteksten injecteert. Alleen 'definitions' is verplicht: het IAMA-begrippenkader draagt geen beschrijvende kop.",
    "type": "object",
    "properties": {
        "schema_version": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "name": {
            "type": "string"
        },
        "description": {
            "type": "string"
        },
        "urn": {
            "type": "string",
            "pattern": "^urn:nl:[A-Za-z0-9._-]+(:[A-Za-z0-9._-]+)*$"
        },
        "language": {
            "type": "string",
            "enum": [
                "nl"
            ]
        },
        "version_date": {
            "type": "string",
            "format": "date"
        },
        "owners": {
            "type": "array",
            "minItems": 1,
            "items": {
                "type": "object",
                "properties": {
                    "organization": {
                        "type": "string"
                    },
                    "name": {
                        "type": "string"
                    },
                    "email": {
                        "type": "string",
                        "format": "email"
                    },
                    "role": {
                        "type": "string"
                    }
                },
                "required": [
                    "organization",
                    "name",
                    "email",
                    "role"
                ],
                "additionalProperties": false
            }
        },
        "definitions": {
            "type": "array",
            "minItems": 1,
            "items": {
                "type": "object",
                "properties": {
                    "id": {
                        "$ref": "#/$defs/slug"
                    },
                    "term": {
                        "type": "string"
                    },
                    "category": {
                        "type": "string"
                    },
                    "definition": {
                        "type": "string"
                    },
                    "metadata": {
                        "type": "object",
                        "properties": {
                            "kennisbronnen": {
                                "$ref": "#/$defs/tekstlijst"
                            },
                            "toelichting": {
                                "type": "string"
                            },
                            "redactionele_opmerking": {
                                "type": "string"
                            },
                            "voorbeelden": {
                                "$ref": "#/$defs/tekstlijst"
                            },
                            "meervoudsvormen": {
                                "$ref": "#/$defs/tekstlijst"
                            },
                            "alternatieve_spellingen": {
                                "$ref": "#/$defs/tekstlijst"
                            }
                        },
                        "additionalProperties": false
                    }
                },
                "required": [
                    "term",
                    "definition"
                ],
                "additionalProperties": false
            }
        },
        "alternative_terms": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "id": {
                        "$ref": "#/$defs/slug"
                    },
                    "term": {
                        "type": "string"
                    },
                    "voorkeur_id": {
                        "$ref": "#/$defs/slug"
                    }
                },
                "required": [
                    "id",
                    "term",
                    "voorkeur_id"
                ],
                "additionalProperties": false
            }
        }
    },
    "required": [
        "definitions"
    ],
    "additionalProperties": false,
    "$defs": {
        "slug": {
            "description": "Kleine letters, cijfers en leestekens zonder witruimte of hoofdletters; accenten toegestaan.",
            "type": "string",
            "pattern": "^[^A-Z\\s]+$"
        },
        "tekstlijst": {
            "type": "array",
            "items": {
                "type": "string"
            }
        }
    }
}
